{
    "name": "rekhu/core",
    "description": "Rekhu Core for Laravel: install Rekhu's knowers (Rekhu Machines first) into your app, with your tenants, your users, your limits and a usage ledger to charge your own customers from.",
    "keywords": ["laravel", "ai", "print", "printing", "machines", "multi-tenant", "rekhu"],
    "homepage": "https://rekhu.com",
    "type": "library",
    "license": "proprietary",
    "authors": [{ "name": "Rekhu", "email": "hello@rekhu.com", "homepage": "https://rekhu.com" }],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.48|^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.2"
    },
    "autoload": { "psr-4": { "Rekhu\\Core\\": "src/" } },
    "autoload-dev": { "psr-4": { "Rekhu\\Core\\Tests\\": "tests/" } },
    "extra": { "laravel": { "providers": ["Rekhu\\Core\\RekhuServiceProvider"] } },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0",
        "laravel/pint": "^1.18"
    },
    "scripts": { "test": "phpunit", "lint": "pint", "lint:check": "pint --test" },
    "config": { "sort-packages": true }
}
